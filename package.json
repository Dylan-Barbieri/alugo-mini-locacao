{
  "name": "alugo-mini-locacao",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Painel administrativo demonstrativo para mini-locação de motocicletas Alu.GO.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "test:webhook": "node scripts/payment-webhook-integration.mjs",
    "test:phase4": "node scripts/phase4-smoke.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:simulation-disabled": "node scripts/simulation-disabled-smoke.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "supabase": "^2.120.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  }
